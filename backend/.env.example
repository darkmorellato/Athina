# ═══════════════════════════════════════════════════════════════════════════
# Agent Athina — Backend environment
# Copy to backend/.env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# ─── AI provider (OpenAI-compatible) ───────────────────────────────────────
# Option A (cloud, default): NVIDIA NIM — get a key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE

# Option B (LOCAL, open-source models — recommended for autonomy + privacy):
#   1. Install Ollama:  https://ollama.com/download
#   2. Pull a reasoning model with tool calling:
#        ollama pull qwen3:8b        # 5.2 GB, 40K ctx, tools + thinking, ótimo pt-BR
#        ollama pull qwen3:4b        # 2.5 GB, 256K ctx, para máquinas modestas
#        ollama pull qwen3:14b       # 9.3 GB, mais qualidade
#   3. Uncomment:
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3:8b
# AGENT_MODEL=qwen3:8b

# Override base URL/key for any OpenAI-compatible server (llama.cpp, vLLM, NIM)
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=
# AI_MODEL=

# ─── Autonomous agent (server-side auto-reply) ─────────────────────────────
# true = responde clientes automaticamente, mesmo com o painel fechado.
# O painel entra em modo monitor para evitar respostas duplicadas.
AGENT_AUTOREPLY=false
# Model with tool-calling support used by the autonomous agent
# (default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning on NIM, or set qwen3:8b locally)
AGENT_MODEL=
# Máximo de iterações de ferramentas por mensagem
AGENT_MAX_STEPS=5

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Em produção (NODE_ENV=production), defina ALLOWED_ORIGIN e ADMIN_SECRET.

# Hops de reverse proxy para o rate limit por IP (0 = exposto direto; 1 = um nginx)
TRUST_PROXY=0

# CORS allowed origin (required in production)
# ALLOWED_ORIGIN=https://yourdomain.com

# ─── Redis (chat state, analytics, queues) ─────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Paymobi Portal Credentials ─────────────────────────────────────────────
PAYMOBI_EMAIL=your@email.com
PAYMOBI_PASSWORD=your_password
PAYMOBI_LOGIN_URL=https://www.paymobi.com.br/views/modules/login_page.php

# ─── Admin secret for privileged socket operations (e.g., restart) ──────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
# Com ADMIN_SECRET definido, o handshake do painel exige o token
# (console do navegador: localStorage.setItem('athina_admin_token','<valor>')).
# Sem ADMIN_SECRET, apenas conexões locais (loopback) são aceitas.

# ─── Local TTS (Kokoro ONNX) ─────────────────────────────────────────────────
# URL do servidor TTS local (backend/ttsServer.py)
TTS_SERVER_URL=http://127.0.0.1:5050

# ─── NVIDIA Riva / NCVF TTS — Chatterbox-Multilingual (premium) ──────────────
# Vozes no painel: "Chatterbox (NVIDIA)" = riva / riva_male / riva_female.
# Sem chave, o servidor cai automaticamente para o Kokoro local.
RIVA_API_KEY=nvapi-YOUR_KEY_HERE
RIVA_SERVER=grpc.nvcf.nvidia.com:443
RIVA_TTS_FUNCTION_ID=ddacc747-1269-4fab-bfd9-8f593dead106
MAGPIE_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969

# ─── Resemble AI API Configuration (optional — falls back to local TTS) ─────
RESEMBLE_API_KEY=
RESEMBLE_SYNTHESIS_URL=https://f.cluster.resemble.ai/synthesize
RESEMBLE_STREAMING_URL=https://f.cluster.resemble.ai/stream
RESEMBLE_VOICE_UUID=

# ─── Observabilidade: Langfuse (opcional) ───────────────────────────────────
# Tracing das decisões do LLM via OpenTelemetry → Langfuse.
# SEM estas chaves o tracing fica 100% OFF (nenhum dado sai da máquina).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=https://cloud.langfuse.com   # self-host: seu endpoint

# ─── Memória semântica (opcional) ───────────────────────────────────────────
# LanceDB + embeddings do NIM (memória vetorial de atendimentos).
# Default: DESLIGADA. Com true, o agente busca/grava memórias similares.
# AGENT_SEMANTIC_MEMORY=true
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# SEMANTIC_MEMORY_DIR=   # opcional (padrão: backend/data/lance-memory)

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
