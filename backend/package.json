{
  "name": "athina-backend",
  "version": "1.0.0",
  "description": "Athina AI Agent - Backend API Server",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "clear-session": "tsx src/utils/clearSession.ts",
    "kill-browsers": "tsx src/utils/killZombieBrowsers.ts",
    "clean": "npm run kill-browsers && npm run clear-session",
    "diagnose": "tsx src/utils/diagnostics.ts",
    "test": "ATHINA_DB_PATH=:memory: tsx tests/athina_flow.smoke.ts",
    "test:tts": "tsx tests/_tts_integration.ts"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.66",
    "@langfuse/otel": "^5.13.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "ai": "^7.0.133",
    "async-mutex": "^0.5.0",
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "lru-cache": "^11.5.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.64.0",
    "puppeteer": "^24.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js#main",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
