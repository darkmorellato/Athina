# Backend WebSocket URL (optional, defaults to http://localhost:3001)
VITE_BACKEND_URL=http://localhost:3001

# Admin token for privileged operations (restart WhatsApp, clear session).
# Must match the backend ADMIN_SECRET configured in backend/.env.
# Alternatively, set it at runtime in the browser console:
#   localStorage.setItem('athina_admin_token', '<your ADMIN_SECRET>')
VITE_ADMIN_TOKEN=
